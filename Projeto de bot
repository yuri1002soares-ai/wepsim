            print(f"Aposta colocada: {amount} no número {number}")
            return True
        except:
            return False

class AIPredictor:
    def __init__(self):
        try:
            self.model = joblib.load(MODEL_FILE)
            print("Modelo de IA carregado com sucesso")
        except:
            self.model = IsolationForest(contamination=0.05)
            print("Novo modelo de IA criado")
        
    def train_model(self, data):
        self.model.fit(np.array(data).reshape(-1, 1))
        joblib.dump(self.model, MODEL_FILE)
        
    def detect_bias(self, number, history):
        if len(history) < 100:
            return False
            
        # Detecção de anomalias
        prediction = self.model.predict([[number]])
        return prediction[0] == -1  # Número atípico
    
    def cluster_analysis(self, history):
        if len(history) < 50:
            return []
            
        # Agrupamento de padrões
        kmeans = KMeans(n_clusters=5)
        clusters = kmeans.fit_predict(np.array(history).reshape(-1, 1))
        
        # Números mais frequentes por cluster
        cluster_numbers = {}
        for num, cluster in zip(history, clusters):
            if cluster not in cluster_numbers:
                cluster_numbers[cluster] = []
            cluster_numbers[cluster].append(num)
            
        # Selecionar números com maior frequência
        target_numbers = []
        for cluster in cluster_numbers.values():
            if len(cluster) > 5:  # Cluster significativo
                target_numbers.append(max(set(cluster), key=cluster.count))
                
        return target_numbers

class StrategyEngine:
    def __init__(self):
        self.pelayo_enabled = True
        self.bazeira_enabled = True
        self.base_bet = 10
        self.progression = [1, 2, 3, 5, 8, 13, 21, 34]
        self.current_step = 0
        
    def calculate_bet(self, last_win):
        if not self.bazeira_enabled:
            return self.base_bet
            
        if last_win:
            self.current_step = max(0, self.current_step - 2)
        else:
            self.current_step = min(len(self.progression) - 1, self.current_step + 1)
            
        return self.base_bet * self.progression[self.current_step]
    
    def get_target_numbers(self, history, last_number):
        targets = []
        
        # Estratégia Pelayo (detecção de viés)
        if self.pelayo_enabled and len(history) > 100:
            # Números recentemente frequentes
            recent = history[-20:]
            freq = pd.Series(recent).value_counts()
            if freq.max() > 5:  # Significativamente acima da média
                targets.append(freq.idxmax())
        
        return targets if targets else [last_number + 1]  # Padrão simples

class RouletteWheel3D(QGraphicsView):
    def __init__(self):
        super().__init__()
        self.setRenderHint(QPainter.RenderHint.Antialiasing)
        self.setViewport(QOpenGLWidget())
        self.scene = QGraphicsScene()
        self.setScene(self.scene)
        self.wheel_items = []
        self._init_wheel()
        self.last_number = None
        
    def _init_wheel(self):
        # Criar roda de roleta em 3D
        radius = 200
        for i in range(37):
            angle = (360 / 37) * i
            rad_angle = np.radians(angle)
            
            # Posicionamento 3D (simulado)
            x = radius * np.cos(rad_angle)
            y = radius * np.sin(rad_angle)
            z = 50 * np.sin(rad_angle/2)  # Profundidade
            
            # Cores
            if i == 0:
                color = QColor(0, 128, 0)  # Verde
            else:
                color = QColor(200, 0, 0) if i % 2 == 0 else QColor(0, 0, 0)
                
            # Gradiente para efeito 3D
            gradient = QLinearGradient(x-15, y-15, x+15, y+15)
            gradient.setColorAt(0, color.lighter(150))
            gradient.setColorAt(1, color.darker(150))
            
            # Criar pochete
            pocket = self.scene.addEllipse(
                x-20, y-20, 40, 40, 
                QPen(Qt.GlobalColor.transparent), 
                QBrush(gradient)
            )
            pocket.setZValue(z)
            
            # Adicionar número
            text = self.scene.addText(str(i), QFont("Arial", 10, QFont.Weight.Bold))
            text.setDefaultTextColor(Qt.GlobalColor.white)
            text.setPos(x-8, y-10)
            text.setZValue(z+1)
            
            self.wheel_items.append(pocket)
    
    def spin_wheel(self, number):
        # Resetar cores
        for i, item in enumerate(self.wheel_items):
            color = QColor(0, 128, 0) if i == 0 else (
                QColor(200, 0, 0) if i % 2 == 0 else QColor(0, 0, 0)
            )
            item.setBrush(color)
        
        # Destacar número vencedor
        if 0 <= number < len(self.wheel_items):
            winner = self.wheel_items[number]
            winner.setBrush(QColor(255, 215, 0))  # Dourado
            winner.setZValue(100)  # Trazer para frente
            
            # Efeito de animação (simplificado)
            self.last_number = number
            
    def resizeEvent(self, event):
        super().resizeEvent(event)
        self.fitInView(self.scene.sceneRect(), Qt.AspectRatioMode.KeepAspectRatio)

