    def _init_driver(self):
        options = webdriver.ChromeOptions()
        options.add_argument("--disable-infobars")
        options.add_argument("--disable-notifications")
        options.add_argument("--mute-audio")
        options.add_argument("--start-maximized")
        return webdriver.Chrome(options=options)
    
    def login(self):
        try:
            self.driver.get(CASINO_URL)
            WebDriverWait(self.driver, 15).until(
                EC.presence_of_element_located((By.ID, "email"))
            ).send_keys(self.username)
            
            self.driver.find_element(By.ID, "password").send_keys(self.password)
            self.driver.find_element(By.XPATH, "//button[contains(text(),'Entrar')]").click()
            
            WebDriverWait(self.driver, 20).until(
                EC.presence_of_element_located((By.CLASS_NAME, "roulette-container"))
            return True
        except Exception as e:
            print(f"Erro no login: {str(e)}")
            return False
    
    def capture_table(self):
        try:
            table = self.driver.find_element(By.CLASS_NAME, "roulette-table")
            return table.screenshot_as_png
        except:
            return None
    
    def place_bet(self, number, amount):
        try:
